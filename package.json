{
  "name": "qrhub",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.15.1",
  "imports": {
    "@/*": "./src/*"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm generate:brand && astro build && node scripts/finalize-sitemap.mjs",
    "generate:brand": "UPDATE_BRAND_ASSETS=1 vitest run src/features/brand/write-favicon.test.ts",
    "deploy": "wrangler deploy",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "budget": "node scripts/bundle-size.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "verify": "pnpm check && pnpm test && pnpm build && pnpm budget && pnpm test:e2e"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.1.2",
    "clsx": "^2.1.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "uqr": "^0.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.61.1",
    "axe-core": "^4.12.1",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.4.0",
    "qrcode-generator": "^2.0.4",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  }
}
