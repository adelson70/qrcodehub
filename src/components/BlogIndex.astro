---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPosts, postPath } from '@/features/blog/blog';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isPt = locale === 'pt-BR';
const posts = await getPosts(locale);

const canonical = isPt ? '/pt/blog' : '/blog';
const alternates = { en: '/blog', 'pt-BR': '/pt/blog' } as const;

const title = isPt ? 'Blog do QRHub' : 'QRHub Blog';
const description = isPt
  ? 'Respostas diretas sobre QR Codes: por que eles expiram, por que param de funcionar e como fazer um que dure para sempre.'
  : 'Straight answers about QR codes: why they expire, why they stop working, and how to make one that lasts forever.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: title,
    description,
    inLanguage: locale,
    url: new URL(canonical, Astro.site).toString(),
  },
];

const dateFormatter = new Intl.DateTimeFormat(isPt ? 'pt-BR' : 'en-GB', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<BaseLayout
  title={`${title} | QRHub`}
  description={description}
  canonical={canonical}
  alternates={alternates}
  schema={schema}
>
  <main id="main" class="mx-auto max-w-6xl px-6 py-12 sm:py-16">
    <header class="mb-10 max-w-2xl">
      <h1 class="text-h1">{title}</h1>
      <p class="mt-3 text-body text-text-secondary">{description}</p>
    </header>

    {
      posts.length === 0 ? (
        <p class="text-body text-text-secondary">
          {isPt ? 'Nada publicado ainda.' : 'Nothing published yet.'}
        </p>
      ) : (
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <li>
              <a
                href={postPath(post.id, locale)}
                class="flex h-full flex-col gap-2 rounded-lg border border-border bg-surface p-5 transition-colors duration-(--duration-fast) hover:bg-surface-hover"
              >
                <span class="text-h3 text-balance text-text-primary">
                  {post.data.title}
                </span>
                <span class="text-body-sm text-text-secondary">
                  {post.data.description}
                </span>
                <time
                  datetime={post.data.publishedAt.toISOString()}
                  class="mt-auto text-caption text-text-secondary"
                >
                  {dateFormatter.format(post.data.publishedAt)}
                </time>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </main>
</BaseLayout>
