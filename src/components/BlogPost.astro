---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  getRelatedPosts,
  getTranslations,
  postPath,
  type Post,
} from '@/features/blog/blog';
import type { Locale } from '@/i18n/config';

interface Props {
  post: Post;
  locale: Locale;
}

const { post, locale } = Astro.props;
const { Content } = await render(post);

const alternates = await getTranslations(post.data.translationKey);
const related = await getRelatedPosts(post, locale);
const canonical = postPath(post.id, locale);

const isPt = locale === 'pt-BR';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    inLanguage: locale,
    datePublished: post.data.publishedAt.toISOString(),
    dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
    mainEntityOfPage: new URL(canonical, Astro.site).toString(),
    author: { '@type': 'Organization', name: 'QRHub' },
    publisher: { '@type': 'Organization', name: 'QRHub' },
  },
  ...(post.data.faq && post.data.faq.length > 0
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          inLanguage: locale,
          mainEntity: post.data.faq.map((entry) => ({
            '@type': 'Question',
            name: entry.question,
            acceptedAnswer: { '@type': 'Answer', text: entry.answer },
          })),
        },
      ]
    : []),
];

const dateFormatter = new Intl.DateTimeFormat(isPt ? 'pt-BR' : 'en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={`${post.data.title} | QRHub`}
  description={post.data.description}
  canonical={canonical}
  alternates={alternates}
  schema={schema}
>
  <main id="main" class="mx-auto max-w-6xl px-6 py-12 sm:py-16">
    <div class="grid gap-16 lg:grid-cols-[minmax(0,1fr)_280px]">
      <article class="max-w-2xl">
        <header class="mb-8">
          <a
            href={isPt ? '/pt/blog' : '/blog'}
            class="text-body-sm text-text-secondary transition-colors duration-(--duration-fast) hover:text-text-primary"
          >
            &larr; Blog
          </a>
          <h1 class="mt-3 text-h1 text-balance">{post.data.title}</h1>
          <p class="mt-3 text-body text-text-secondary text-pretty">
            {post.data.description}
          </p>
          <p class="mt-4 text-caption text-text-secondary">
            <time datetime={post.data.publishedAt.toISOString()}>
              {dateFormatter.format(post.data.publishedAt)}
            </time>
            {
              post.data.updatedAt && (
                <>
                  {' · '}
                  {isPt ? 'atualizado em' : 'updated'}{' '}
                  <time datetime={post.data.updatedAt.toISOString()}>
                    {dateFormatter.format(post.data.updatedAt)}
                  </time>
                </>
              )
            }
          </p>
        </header>

        {/*
          Article body diverges from the UI type scale on purpose: reading and
          scanning are different tasks. Wider line height, a measure capped near
          68 characters, and generous spacing between blocks.
        */}
        <div
          class="flex flex-col gap-5 text-body leading-[1.75] text-text-secondary [&>h2]:mt-8 [&>h2]:text-h2 [&>h2]:text-text-primary [&>h3]:mt-4 [&>h3]:text-h3 [&>h3]:text-text-primary [&>ol]:flex [&>ol]:list-decimal [&>ol]:flex-col [&>ol]:gap-2 [&>ol]:pl-5 [&>strong]:text-text-primary [&>ul]:flex [&>ul]:list-disc [&>ul]:flex-col [&>ul]:gap-2 [&>ul]:pl-5 [&_a]:text-accent [&_a]:underline [&_code]:font-mono [&_code]:text-body-sm [&_strong]:text-text-primary"
        >
          <Content />
        </div>
      </article>

      <aside class="flex flex-col gap-8 lg:sticky lg:top-8 lg:self-start">
        <section class="rounded-lg border border-border bg-surface p-4">
          <h2 class="text-h3">
            {isPt ? 'Gere um QR Code agora' : 'Generate a QR code now'}
          </h2>
          <p class="mt-2 text-body-sm text-text-secondary">
            {
              isPt
                ? 'Gratuito, sem cadastro, e nunca expira.'
                : 'Free, no signup, and it never expires.'
            }
          </p>
          <a
            href={isPt ? '/pt' : '/'}
            class="mt-3 inline-flex h-9 items-center rounded-md bg-accent px-4 text-body-sm font-medium text-accent-fg transition-colors duration-(--duration-fast) hover:bg-accent-hover"
          >
            {isPt ? 'Abrir o gerador' : 'Open the generator'}
          </a>
          <a
            href={isPt ? '/pt/ferramentas' : '/tools'}
            class="mt-3 block text-body-sm text-accent underline-offset-2 hover:underline"
          >
            {isPt ? 'Todos os geradores' : 'All generators'}
          </a>
        </section>

        {
          related.length > 0 && (
            <section>
              <h2 class="text-h3">{isPt ? 'Leia também' : 'Related reading'}</h2>
              <ul class="mt-3 flex flex-col gap-2">
                {related.map((entry) => (
                  <li>
                    <a
                      href={postPath(entry.id, locale)}
                      class="block rounded-lg border border-border bg-surface p-3 text-body-sm text-text-primary transition-colors duration-(--duration-fast) hover:bg-surface-hover"
                    >
                      {entry.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </aside>
    </div>
  </main>
</BaseLayout>
