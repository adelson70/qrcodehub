---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations } from '@/i18n/ui';

const tEn = useTranslations('en');
const tPt = useTranslations('pt-BR');

const alternates = { en: '/', 'pt-BR': '/pt' } as const;
---

<BaseLayout
  title={`${tEn('notFound.title')} — QRHub`}
  description={tEn('notFound.lead')}
  noindex
  alternates={alternates}
>
  <main id="main" class="mx-auto max-w-6xl px-6 py-12 sm:py-20">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-display font-semibold text-text-secondary/40" aria-hidden="true">404</p>
      <h1 id="not-found-title" class="mt-2 text-h1">{tEn('notFound.title')}</h1>
      <p id="not-found-lead" class="mt-3 text-body text-text-secondary">{tEn('notFound.lead')}</p>
      <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <a
          id="not-found-home"
          href="/"
          class="inline-flex min-h-11 items-center rounded-md bg-accent px-5 text-body-sm font-medium text-accent-fg transition-colors duration-(--duration-fast) hover:bg-accent-hover"
        >
          {tEn('notFound.home')}
        </a>
        <a
          id="not-found-tools"
          href="/tools"
          class="inline-flex min-h-11 items-center rounded-md border border-border-strong bg-surface px-5 text-body-sm font-medium text-text-primary transition-colors duration-(--duration-fast) hover:bg-surface-hover"
        >
          {tEn('notFound.tools')}
        </a>
      </div>
    </div>
  </main>

  {/*
    Static 404.html is built once; the requested URL is only known in the
    browser. Swap copy and links when the missing path was under /pt.
  */}
  <script
    is:inline
    define:vars={{
      ptTitle: tPt('notFound.title'),
      ptLead: tPt('notFound.lead'),
      ptHome: tPt('notFound.home'),
      ptTools: tPt('notFound.tools'),
    }}
  >
    if (location.pathname.startsWith('/pt')) {
      document.documentElement.lang = 'pt-BR';
      document.title = ptTitle + ' — QRHub';

      var title = document.getElementById('not-found-title');
      var lead = document.getElementById('not-found-lead');
      var home = document.getElementById('not-found-home');
      var tools = document.getElementById('not-found-tools');

      if (title) title.textContent = ptTitle;
      if (lead) lead.textContent = ptLead;
      if (home) {
        home.textContent = ptHome;
        home.href = '/pt';
      }
      if (tools) {
        tools.textContent = ptTools;
        tools.href = '/pt/ferramentas';
      }
    }
  </script>
</BaseLayout>
