---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AdSlot from '@/components/ads/AdSlot.astro';
import { qrTypes } from '@/features/qr/registry';
import { getTypeContent } from '@/features/qr/types/content';
import { TYPE_LOCALES, typePath } from '@/features/qr/types/locales';
import type { Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/ui';

/**
 * The hub. Exists as much for crawlers as for people: it guarantees every type
 * page is one link from a page that is itself one link from the homepage.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const canonical = locale === 'en' ? '/tools' : '/pt/ferramentas';
const alternates = { en: '/tools', 'pt-BR': '/pt/ferramentas' } as const;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: t('tools.title'),
    url: new URL(canonical, Astro.site).toString(),
    inLanguage: locale,
    hasPart: qrTypes.map((type) => ({
      '@type': 'SoftwareApplication',
      name: TYPE_LOCALES[locale][type.id]?.seo.title,
      url: new URL(typePath(type.id, locale), Astro.site).toString(),
      applicationCategory: 'UtilitiesApplication',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    })),
  },
];
---

<BaseLayout
  title={`${t('tools.title')} | QRHub`}
  description={t('tools.lead')}
  canonical={canonical}
  alternates={alternates}
  schema={schema}
>
  <main id="main" class="mx-auto max-w-6xl px-6 py-12 sm:py-16">
    <header class="mb-10 max-w-2xl">
      <h1 class="text-h1">{t('tools.title')}</h1>
      <p class="mt-3 text-body text-text-secondary">{t('tools.lead')}</p>
    </header>

    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        qrTypes.map((type) => {
          const meta = TYPE_LOCALES[locale][type.id];
          if (!meta) return null;
          return (
            <li>
              <a
                href={typePath(type.id, locale)}
                class="flex h-full flex-col gap-2 rounded-lg border border-border bg-surface p-5 transition-colors duration-(--duration-fast) hover:bg-surface-hover"
              >
                <span class="text-h3 text-text-primary">{meta.label}</span>
                <span class="text-body-sm text-text-secondary">
                  {getTypeContent(type.id, locale)?.intro}
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>

    <AdSlot />
  </main>
</BaseLayout>
