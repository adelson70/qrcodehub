---
/**
 * The type page template, shared by both locales.
 *
 * One implementation rather than one per language: the structure, the schema
 * and the accessibility wiring are identical everywhere, and only the words
 * change. Duplicating it would guarantee the two drift.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import AdSlot from '@/components/ads/AdSlot.astro';
import TypeStudio from '@/features/qr/studio/TypeStudio';
import { getRelatedTypes } from '@/features/qr/registry';
import { getTypeContent } from '@/features/qr/types/content';
import { TYPE_LOCALES, typeAlternates, typePath } from '@/features/qr/types/locales';
import type { Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/ui';

interface Props {
  typeId: string;
  locale: Locale;
}

const { typeId, locale } = Astro.props;
const t = useTranslations(locale);

const meta = TYPE_LOCALES[locale][typeId]!;
const content = getTypeContent(typeId, locale)!;
const related = getRelatedTypes(typeId);

const canonical = typePath(typeId, locale);
const pageUrl = new URL(canonical, Astro.site).toString();
const lowerLabel = meta.label.toLowerCase();

/*
 * SoftwareApplication and BreadcrumbList are the two that still earn anything:
 * breadcrumbs render in results, and the application entry is eligible for
 * price display. FAQPage is included for semantic clarity only -- Google
 * restricted FAQ rich results to government and health sites in 2023, so it
 * should be budgeted at zero expected snippets.
 */
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: meta.seo.title,
    description: meta.seo.description,
    url: pageUrl,
    inLanguage: locale,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'QRHub',
        item: new URL(locale === 'en' ? '/' : '/pt', Astro.site).toString(),
      },
      { '@type': 'ListItem', position: 2, name: meta.label, item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: locale,
    mainEntity: content.faq.map((entry) => ({
      '@type': 'Question',
      name: entry.question,
      acceptedAnswer: { '@type': 'Answer', text: entry.answer },
    })),
  },
];
---

<BaseLayout
  title={`${meta.seo.title} | QRHub`}
  description={meta.seo.description}
  canonical={canonical}
  alternates={typeAlternates(typeId)}
  schema={schema}
>
  <main id="main" class="mx-auto max-w-6xl px-6 py-12 sm:py-16">
    <header class="mb-10 max-w-2xl">
      <h1 class="text-h1 text-balance">{meta.seo.title}</h1>
      <p class="mt-3 text-body text-text-secondary text-pretty">{content.intro}</p>
    </header>

    <TypeStudio typeId={typeId} client:load />

    <AdSlot />

    {/* ------------------------------------------------------------------ */}
    {/* Below the fold: the content that makes the page rank.              */}
    {/* ------------------------------------------------------------------ */}
    <div
      class="mt-20 grid gap-16 border-t border-border pt-12 lg:grid-cols-[minmax(0,1fr)_320px]"
    >
      <div class="flex max-w-2xl flex-col gap-12">
        <section>
          <h2 class="text-h2">{t('page.howTo')} {lowerLabel}</h2>
          <ol class="mt-4 flex flex-col gap-3">
            {
              content.steps.map((step, index) => (
                <li class="flex gap-3 text-body text-text-secondary">
                  <span
                    class="flex size-6 shrink-0 items-center justify-center rounded-full border border-border text-caption font-medium text-text-primary"
                    aria-hidden="true"
                  >
                    {index + 1}
                  </span>
                  <span>{step}</span>
                </li>
              ))
            }
          </ol>
        </section>

        <section>
          <h2 class="text-h2">{t('page.whatIs')} {lowerLabel}?</h2>
          {
            content.explainer.map((paragraph) => (
              <p class="mt-4 text-body text-text-secondary">{paragraph}</p>
            ))
          }
        </section>

        {/* my-0: the parent flex column already supplies the gap-12 rhythm. */}
        <AdSlot class="my-0" />

        <section>
          <h2 class="text-h2">{t('page.expires')}</h2>
          <p class="mt-4 text-body text-text-secondary">{content.expiry}</p>
        </section>

        <section>
          <h2 class="text-h2">{t('page.faq')}</h2>
          <dl class="mt-4 flex flex-col divide-y divide-border border-y border-border">
            {
              content.faq.map((entry) => (
                <div class="py-5">
                  <dt class="text-h3">{entry.question}</dt>
                  <dd class="mt-2 text-body text-text-secondary">{entry.answer}</dd>
                </div>
              ))
            }
          </dl>
        </section>
      </div>

      <aside class="flex flex-col gap-8">
        <section>
          <h2 class="text-h3">{t('page.related')}</h2>
          <ul class="mt-3 flex flex-col gap-2">
            {
              related.map((entry) => {
                const relatedMeta = TYPE_LOCALES[locale][entry.id];
                if (!relatedMeta) return null;
                return (
                  <li>
                    <a
                      href={typePath(entry.id, locale)}
                      class="flex flex-col gap-0.5 rounded-lg border border-border bg-surface p-3 transition-colors duration-(--duration-fast) hover:bg-surface-hover"
                    >
                      <span class="text-body-sm font-medium text-text-primary">
                        {relatedMeta.label}
                      </span>
                      <span class="text-caption text-text-secondary">
                        {relatedMeta.seo.keyword}
                      </span>
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </section>

        <section class="rounded-lg border border-border p-4">
          <h2 class="text-h3">{t('page.privacyTitle')}</h2>
          <p class="mt-2 text-body-sm text-text-secondary">{t('page.privacyBody')}</p>
        </section>
      </aside>
    </div>
  </main>
</BaseLayout>
