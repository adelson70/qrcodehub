---
/**
 * Full-screen overlay shown when an ad blocker is detected.
 *
 * Not dismissible — the visitor must disable their blocker and refresh. The bait
 * element and detection logic mirror `detect-adblock.ts`; keep them in sync.
 */
import { ads } from '@/features/ads/env';
import { useTranslations } from '@/i18n/ui';
import { localeFromPath } from '@/i18n/utils';

const t = useTranslations(localeFromPath(Astro.url.pathname));
---

{
  ads.enabled && (
    <>
      {/*
        Off-screen bait targeted by common block lists. Ad blockers hide or
        remove elements with these class names; a zero-height bait is the signal.
      */}
      <div
        id="adblock-bait"
        class="adsbox"
        aria-hidden="true"
        style="position:absolute;left:-9999px;width:1px;height:1px;"
      />

      <div
        id="adblock-overlay"
        data-testid="adblock-overlay"
        class="fixed inset-0 z-50 hidden items-center justify-center bg-bg/95 p-6 backdrop-blur-sm"
        role="alertdialog"
        aria-modal="true"
        aria-labelledby="adblock-title"
        aria-describedby="adblock-body adblock-reassurance adblock-refresh"
      >
        <div class="mx-auto max-w-md text-center">
          <h2 id="adblock-title" class="text-h2 font-semibold text-text-primary">
            {t('ads.adblock.title')}
          </h2>
          <p id="adblock-body" class="mt-3 text-body-sm text-text-secondary">
            {t('ads.adblock.body')}
          </p>
          <p id="adblock-reassurance" class="mt-3 text-body-sm text-text-secondary">
            {t('ads.adblock.reassurance')}
          </p>
          <p id="adblock-refresh" class="mt-6 text-body-sm font-medium text-text-primary">
            {t('ads.adblock.refresh')}
          </p>
        </div>
      </div>

      <script is:inline>
        (function () {
          var DELAY_MS = 2000;

          function isAdBlockActive(bait, adsbygoogle) {
            if (!bait || bait.offsetHeight === 0 || bait.offsetParent === null) return true;
            if (typeof adsbygoogle === 'undefined') return true;
            return false;
          }

          function run() {
            var bait = document.getElementById('adblock-bait');
            var overlay = document.getElementById('adblock-overlay');
            if (!overlay) return;

            if (isAdBlockActive(bait, window.adsbygoogle)) {
              overlay.classList.remove('hidden');
              overlay.classList.add('flex');
              document.body.style.overflow = 'hidden';
            }
          }

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function () {
              setTimeout(run, DELAY_MS);
            });
          } else {
            setTimeout(run, DELAY_MS);
          }
        })();
      </script>
    </>
  )
}
