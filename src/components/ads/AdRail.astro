---
/**
 * A desktop side rail, pinned to the edge of the viewport.
 *
 * Shown only at 2xl and above. Below 1536px the maths does not work: the
 * content column is a fixed 1152px, so a narrower viewport leaves under 160px
 * of clearance per side and the rail would sit on top of the text. At exactly
 * 1536px there is 192px each side -- 160 of rail plus 16 of margin, with 16 to
 * spare. `AdSlot` covers everything below that breakpoint.
 *
 * `fixed` rather than `sticky`, which gives two things at once: the rail stays
 * in view for the whole scroll, and being out of the document flow it cannot
 * shift a single pixel of content. Contributed layout shift is zero by
 * construction, so unlike the in-content slots there is nothing to reserve.
 */
import { ads } from '@/features/ads/env';
import { useTranslations } from '@/i18n/ui';
import { localeFromPath } from '@/i18n/utils';

interface Props {
  side: 'left' | 'right';
}

const { side } = Astro.props;
const t = useTranslations(localeFromPath(Astro.url.pathname));
---

{
  ads.enabled && (
    <div
      class:list={[
        // z-10 keeps the rail above page content but below the header's type
        // menu, which opens at z-30 and must not be covered by an ad.
        'fixed top-24 z-10 hidden w-[160px] 2xl:block',
        side === 'left' ? 'left-4' : 'right-4',
      ]}
    >
      <p class="mb-2 text-center text-caption text-text-secondary">{t('ads.label')}</p>

      {/*
        160x600 is declared outright rather than left responsive. The unit is
        the same responsive one used in-content, but a 160px-wide container
        gives `auto` almost nothing to work with -- naming the skyscraper size
        explicitly is what makes the rail fill reliably.
      */}
      <ins
        class="adsbygoogle"
        style="display:block;width:160px;height:600px"
        data-ad-client={ads.client}
        data-ad-slot={ads.slot}
        data-ad-format="vertical"
      />
      <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </div>
  )
}
