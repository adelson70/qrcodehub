---
/** Same QR as /favicon.svg — generated by scripts/generate-brand-assets.ts */
interface Props {
  class?: string;
}

const { class: className = 'size-5 shrink-0' } = Astro.props;
---

<img
  src="/favicon.svg?v=3"
  alt=""
  width="20"
  height="20"
  class={className}
  aria-hidden="true"
  decoding="async"
/>
