---
import { BRAND_ICON_VERSION } from '@/features/brand/site-qr';

/** Same QR as /favicon.svg — generated by `pnpm generate:brand`. */
interface Props {
  class?: string;
}

const { class: className = 'size-5 shrink-0' } = Astro.props;
const src = `/favicon.svg?v=${BRAND_ICON_VERSION}`;
---

<img
  src={src}
  alt=""
  width="20"
  height="20"
  class={className}
  aria-hidden="true"
  decoding="async"
/>
