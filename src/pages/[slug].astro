---
/**
 * English type pages, generated from the registry.
 *
 * Astro gives static routes priority over dynamic ones, so /tools and the other
 * named pages are unaffected by this catch-all.
 */
import TypePage from '@/components/TypePage.astro';
import { qrTypes } from '@/features/qr/registry';
import { TYPE_LOCALES } from '@/features/qr/types/locales';

export function getStaticPaths() {
  return qrTypes.map((type) => ({
    params: { slug: TYPE_LOCALES.en[type.id]!.slug.replace(/^\//, '') },
    props: { typeId: type.id },
  }));
}

const { typeId } = Astro.props;
---

<TypePage typeId={typeId} locale="en" />
