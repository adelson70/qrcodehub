---
/**
 * TEMPORARY: Step 2 scan verification.
 *
 * Deleted once the renderer is signed off. Its purpose is to be pointed at with
 * a real phone: unit tests prove the matrix is mathematically right, but only a
 * camera proves the drawing is physically readable.
 *
 * Rendered entirely at build time -- renderSvg is a pure function, so this page
 * ships zero JavaScript.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { encodeQr, type ErrorCorrection } from '@/features/qr/encode/encode';
import { renderSvg, type RenderOptions } from '@/features/qr/render/render';
import { qrTypes, serializeForType } from '@/features/qr/registry';

/**
 * Every registered type, rendered from its own example payload. Unit tests
 * prove each serializer emits the right string; only a phone proves the string
 * makes the device do the right thing -- offer to join a network, open a
 * contact card, start a chat.
 */
const typeSamples = qrTypes.map((type) => {
  const outcome = serializeForType(type.id, type.example);
  const payload = outcome.ok ? outcome.text : '';
  const encoded = payload ? encodeQr(payload, { errorCorrection: 'M' }) : null;

  return {
    type,
    payload,
    encoded,
    svg:
      encoded?.ok === true
        ? renderSvg(encoded.matrix, { ariaLabel: `${type.label} example QR code` })
        : null,
  };
});

interface Sample {
  label: string;
  expected: string;
  text: string;
  ecc?: ErrorCorrection;
  render?: RenderOptions;
  /** Set when the sample is expected to be hard or impossible to scan. */
  shouldFail?: string;
}

const samples: Sample[] = [
  {
    label: 'URL · ECC M · defaults',
    expected: 'https://qrhub.app',
    text: 'https://qrhub.app',
  },
  {
    label: 'URL · ECC L',
    expected: 'https://qrhub.app',
    text: 'https://qrhub.app',
    ecc: 'L',
  },
  {
    label: 'URL · ECC Q',
    expected: 'https://qrhub.app',
    text: 'https://qrhub.app',
    ecc: 'Q',
  },
  {
    label: 'URL · ECC H',
    expected: 'https://qrhub.app',
    text: 'https://qrhub.app',
    ecc: 'H',
  },
  {
    label: 'WiFi payload',
    expected: 'Should offer to join network "QRHub Test"',
    text: 'WIFI:T:WPA;S:QRHub Test;P:hunter2hunter2;H:false;;',
    ecc: 'M',
  },
  {
    label: 'Long text · dense symbol',
    expected: 'The full paragraph below',
    text:
      'QRHub generates QR codes entirely in your browser. Nothing you type is ' +
      'ever uploaded, the codes never expire, and there is no watermark. This ' +
      'sample exists to produce a dense symbol and confirm larger versions ' +
      'still scan reliably at screen size.',
    ecc: 'M',
  },
  {
    label: 'Brand accent on white',
    expected: 'https://qrhub.app',
    text: 'https://qrhub.app',
    render: { foreground: '#2563eb' },
  },
  {
    label: 'Transparent background',
    expected: 'https://qrhub.app',
    text: 'https://qrhub.app',
    render: { background: null },
  },
  {
    label: 'Margin 0 · no quiet zone',
    expected: 'https://qrhub.app',
    text: 'https://qrhub.app',
    render: { margin: 0 },
    shouldFail:
      'Expected to be unreliable. The spec requires a 4-module quiet zone; this proves why the default must never be lowered.',
  },
  {
    label: 'Low contrast · deliberately bad',
    expected: 'https://qrhub.app',
    text: 'https://qrhub.app',
    render: { foreground: '#94a3b8', background: '#e2e8f0' },
    shouldFail:
      'Expected to fail or struggle. Establishes the threshold the V2 quality checker must warn about.',
  },
  {
    label: 'Inverted · light on dark',
    expected: 'https://qrhub.app',
    text: 'https://qrhub.app',
    render: { foreground: '#ffffff', background: '#0f172a' },
    shouldFail:
      'Many scanners reject inverted codes. Worth knowing before we offer it as a colour option.',
  },
];

const rendered = samples.map((sample) => {
  const result = encodeQr(sample.text, { errorCorrection: sample.ecc ?? 'M' });
  return {
    ...sample,
    result,
    svg: result.ok
      ? renderSvg(result.matrix, { ...sample.render, ariaLabel: sample.label })
      : null,
  };
});
---

<BaseLayout
  title="QRHub — Scan verification"
  description="Internal renderer scan verification page."
  noindex
>
  <main id="main" class="mx-auto max-w-5xl px-6 py-16">
    <header class="mb-10">
      <h1 class="text-h1">Scan verification</h1>
      <p class="mt-3 max-w-2xl text-body text-text-secondary">
        Point a real phone camera at each code and confirm it decodes to the
        expected value. Test on iOS Camera, Android Camera and Google Lens — they
        use different decoders and disagree more often than you would expect.
      </p>
      <p class="mt-3 max-w-2xl text-body-sm text-text-secondary">
        The last three are expected to misbehave. They are here to map the
        failure boundary, not to pass.
      </p>
    </header>

    <section class="mb-16">
      <h2 class="text-h2">Payload types</h2>
      <p class="mt-2 mb-6 max-w-2xl text-body-sm text-text-secondary">
        Each type rendered from its own example. Check the <em>behaviour</em>,
        not just the decode: WiFi should offer to join a network, vCard should
        open a contact card, WhatsApp should open a chat with the message
        prefilled.
      </p>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          typeSamples.map(({ type, payload, encoded, svg }) => (
            <article class="rounded-lg border border-border p-4">
              <h3 class="mb-3 text-h3">{type.label}</h3>

              {svg ? (
                <div
                  class="mx-auto w-full max-w-[200px] [&>svg]:h-auto [&>svg]:w-full"
                  set:html={svg}
                />
              ) : (
                <p class="text-body-sm text-error">Failed to build payload</p>
              )}

              <p class="mt-4 break-all font-mono text-caption text-text-secondary">
                {payload.length > 140 ? `${payload.slice(0, 140)}…` : payload}
              </p>

              {encoded?.ok === true && (
                <p class="mt-2 text-caption text-text-secondary">
                  v{encoded.matrix.version} · {encoded.matrix.size}&times;
                  {encoded.matrix.size} · {payload.length} chars
                </p>
              )}
            </article>
          ))
        }
      </div>
    </section>

    <h2 class="mb-6 text-h2">Renderer edge cases</h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        rendered.map((sample) => (
          <article
            class:list={[
              'rounded-lg border p-4',
              sample.shouldFail ? 'border-warning' : 'border-border',
            ]}
          >
            <div class="mb-3 flex items-start justify-between gap-2">
              <h2 class="text-h3">{sample.label}</h2>
              {sample.shouldFail && (
                <span class="shrink-0 rounded-sm bg-surface px-2 py-0.5 text-caption text-warning">
                  expected to fail
                </span>
              )}
            </div>

            {sample.svg ? (
              <div
                class="mx-auto w-full max-w-[240px] [&>svg]:h-auto [&>svg]:w-full"
                set:html={sample.svg}
              />
            ) : (
              <p class="text-body-sm text-error">
                Encode failed:{' '}
                {!sample.result.ok && sample.result.failure.message}
              </p>
            )}

            <dl class="mt-4 space-y-1 text-caption">
              <div class="flex gap-2">
                <dt class="shrink-0 text-text-secondary">Expects</dt>
                <dd class="break-all">{sample.expected}</dd>
              </div>
              {sample.result.ok && (
                <div class="flex gap-2">
                  <dt class="shrink-0 text-text-secondary">Symbol</dt>
                  <dd>
                    v{sample.result.matrix.version} ·{' '}
                    {sample.result.matrix.size}&times;{sample.result.matrix.size}{' '}
                    · mask {sample.result.matrix.maskPattern} · ECC{' '}
                    {sample.ecc ?? 'M'}
                  </dd>
                </div>
              )}
            </dl>

            {sample.shouldFail && (
              <p class="mt-3 border-t border-border pt-3 text-caption text-text-secondary">
                {sample.shouldFail}
              </p>
            )}
          </article>
        ))
      }
    </div>
  </main>
</BaseLayout>
